# ---- Яндекс.Диск (обязательно) ----
# OAuth-токен аккаунта, на диск которого складываются файлы.
# Как получить — см. README.md, раздел «Токен Яндекс.Диска».
YANDEX_DISK_TOKEN=

# Корневая папка для заявок
DISK_ROOT=disk:/МИС-заявки

# Публиковать папку заявки по ссылке, чтобы вложения открывались прямо из Planfix.
# false — ссылки не будет, файлы смотрят только из аккаунта Диска.
PUBLISH_FOLDER=true

# ---- Почта в Planfix (обязательно) ----
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# Полный адрес ящика, с которого уходят заявки
SMTP_USER=
# Пароль приложения из Яндекс ID, НЕ пароль от аккаунта.
# Без кавычек, без пробелов, без комментария в этой же строке.
SMTP_PASS=
# Обычно совпадает с SMTP_USER
MAIL_FROM=
MAIL_TO=RomanFigol@sensey.planfix.ru

# Мелкие файлы кладём прямо в письмо, крупные остаются ссылкой на Диск
MAIL_ATTACH_MAX_MB=10
MAIL_ATTACH_TOTAL_MB=20

# ---- Лимиты ----
MAX_FILES=10
MAX_FILE_MB=100
RATE_PER_HOUR=20

# ---- Прочее ----
PORT=3210
TZ=Asia/Yekaterinburg

# ---- Бот в MAX ----
# Токен бота из @MasterBot. Тот же ключ, что отдан Planfix.
MAX_BOT_TOKEN=
# Режим боевого бота: он встаёт вебхуком вместо Planfix и пересылает туда
# только собранную заявку.
BOT_MODE=webhook
BOT_PORT=3211
# Адрес вебхука Planfix — куда отдавать готовый пакет.
# Смотрится командой npm run max:webhook
PLANFIX_WEBHOOK_URL=https://sensey.planfix.ru/endpoints/max?botId=391026515
# Случайная строка: она же в пути вебхука, чтобы чужой POST не прошёл.
BOT_WEBHOOK_SECRET=
